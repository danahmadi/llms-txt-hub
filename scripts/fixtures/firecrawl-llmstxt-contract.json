        "method": "POST",
        "url": "https://api.firecrawl.dev/v1/llmstxt",
        "body": {
          "url": "https://example.com",
          "maxUrls": 50,
          "showFullText": true,
          "origin": "js-sdk@1.25.1"
        },
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer fixture-only"
        }
      },
      {
        "method": "GET",
