[
  {
    "name": "immediate completion",
    "replies": [
      {
        "status": 200,
        "body": {
          "success": true,
          "id": "fixture-job"
        }
      },
      {
        "status": 200,
        "body": {
          "success": true,
          "status": "completed",
          "data": {
            "llmstxt": "# Summary\n☀️",
            "llmsfulltxt": "# Full\n"
          }
        }
      }
    ],
    "expected": {
      "result": {
        "success": true,
