{
  "name": "llms-txt-hub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/search-index-generator.cjs && turbo build",
    "check:frontmatter": "tsx scripts/check-frontmatter.ts",
    "check:links": "lychee --config ./lychee.toml --verbose .",
    "check:websites": "tsx scripts/validate-websites.ts",
    "check:websites:warnings": "tsx scripts/validate-websites.ts --warn-descriptions",
    "clean": "git clean -xdf node_modules dist .next",
    "clean:workspaces": "turbo clean",
    "commit": "cz",
    "dev": "cross-env FORCE_COLOR=1 turbo dev --parallel",
    "format": "biome check --write .",
    "generate-search-index": "node scripts/search-index-generator.js",
    "generate-llms-chatbot-index": "node scripts/llms-chatbot-index-generator.js",
    "generate-websites": "tsx scripts/generate-websites.ts",
    "generate:llms": "pnpm --filter generator start",
    "generate:website": "turbo gen website",
    "postinstall": "manypkg fix",
    "lint": "pnpm check:websites && turbo lint && manypkg check",
    "lint:fix": "turbo lint:fix && manypkg fix && pnpm biome lint --write .",
    "review": "pnpm exec tsx scripts/pr-backfill-dry-run.ts",
    "review:dry-run": "pnpm review -- --dry-run",
    "shadcn": "cd packages/design-system && pnpm dlx shadcn@canary add",
    "start": "turbo run start",
    "test": "turbo test --cache-dir=.turbo",
    "test:e2e": "turbo test:e2e --filter=e2e",
    "test:e2e:smoke": "turbo test:e2e:smoke --filter=e2e",
    "test:e2e:ui": "turbo test:e2e:ui --filter=e2e",
    "test:e2e:debug": "turbo test:e2e:debug --filter=e2e",
    "test:repo": "pnpm exec vitest run scripts/pr-triage.test.ts scripts/pr-backfill-dry-run.test.ts scripts/deployment-dependencies.test.ts scripts/flags-access.test.ts && pnpm test:security-dependencies",
    "test:watch": "turbo test:watch --cache-dir=.turbo",
    "typecheck": "turbo typecheck",
    "update": "pnpm update -r",
    "update-llms-list": "node scripts/update-llms-list.js",
    "contributors:add": "all-contributors add",
    "contributors:generate": "all-contributors generate",
    "contributors:check": "all-contributors check",
    "test:security-dependencies": "node --test scripts/security-dependency-compat.test.mjs",
    "verify:native-security": "node scripts/verify-native-security.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@manypkg/cli": "^0.23.0",
    "@opentelemetry/api": "1.9.1",
    "@thedaviddias/submission-trust": "workspace:*",
    "@turbo/gen": "^2.9.14",
    "@types/js-yaml": "^4.0.9",
    "@types/validator": "^13.15.10",
    "acorn": "^8.15.0",
    "all-contributors-cli": "^6.26.1",
    "chalk": "^5.6.2",
    "cross-env": "^7.0.3",
    "dompurify": "^3.4.17",
    "glob": "^11.1.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "isomorphic-dompurify": "^2.36.0",
    "js-yaml": "^4.3.2",
    "lefthook": "^2.1.1",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "validator": "^13.15.26",
    "vite": "7.3.7",
    "webpack": "5.112.0"
  },
  "pnpm": {
    "overrides": {
      "import-in-the-middle": "^1.14.2",
      "undici@7.21.0": "^7.30.1",
      "fast-uri@3.0.6": "^3.1.9",
      "vite@7.3.1": "^7.3.7",
      "handlebars@4.7.8": "^4.7.10",
      "@fastify/busboy@3.2.0": "^3.2.2",
      "axios@1.13.5": "^1.20.0",
      "brace-expansion@1.1.11": "^1.1.21",
      "brace-expansion@2.0.1": "^2.1.7",
      "brace-expansion@5.0.2": "^5.0.12",
      "baseline-browser-mapping@2.9.19": "^2.11.0",
      "browserslist@4.28.1": "^4.28.7",
      "form-data@4.0.2": "^4.0.6",
      "form-data@4.0.5": "^4.0.6",
      "@babel/core@7.26.9": "^7.29.6",
      "ws@8.18.0": "^8.21.0",
      "ws@7.5.10": "^7.5.11",
      "@tootallnate/once@2.0.0": "^2.0.1",
      "follow-redirects@1.15.11": "^1.16.1",
      "basic-ftp@5.0.5": "^5.2.2",
      "lodash@4.17.21": "^4.18.0",
      "picomatch@2.3.1": "^2.3.2",
      "picomatch@4.0.2": "^4.0.4",
      "picomatch@4.0.3": "^4.0.4",
      "minimatch@3.1.2": "^3.1.4",
      "minimatch@10.2.0": "^10.2.3",
      "rollup@4.57.1": "^4.59.0",
      "webpack@5.98.0": "^5.112.0",
      "mdast-util-to-hast@13.2.0": "^13.2.1",
      "estree-util-value-to-estree@3.3.2": "^3.3.3",
      "@babel/helpers@7.26.9": "^7.26.10",
      "@content-collections/core@0.8.2>serialize-javascript": "7.1.3",
      "external-editor@3.1.0>tmp": "0.2.7",
      "@vercel/microfrontends@1.3.0>path-to-regexp": "6.3.0",
      "@tailwindcss/typography@0.5.19>postcss-selector-parser": "7.1.7",
      "@opentelemetry/api": "1.9.1",
      "@vercel/microfrontends@1.3.0>cookie": "0.7.2",
      "tsx@4.21.0>esbuild": "0.28.2",
      "tsup@8.5.1>esbuild": "0.28.2",
      "minimatch@3.1.3": "^3.1.4",
      "follow-redirects@1.16.0": "^1.16.1",
      "@babel/runtime@7.26.9": "^7.26.10",
      "diff@4.0.2": "^4.0.4",
      "ajv@8.17.1": "^8.18.0",
      "yaml@1.10.2": "^1.10.3",
      "yaml@2.7.0": "^2.8.3"
    }
  },
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=24"
  }
}
